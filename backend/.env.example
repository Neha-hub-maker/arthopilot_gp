# All paths are fixed beneath this backend folder.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# offline: deterministic Bangla parsing, fraud heuristics, extractive RAG.
# ollama: additionally generates grounded Niyom answers with an existing local model.
AI_PROVIDER=offline
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=30
